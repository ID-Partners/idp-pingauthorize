# Your Ping Identity DevOps credentials. The server fetches an evaluation licence with them at
# start-up. Sign up at https://devops.pingidentity.com
PING_IDENTITY_DEVOPS_USER=
PING_IDENTITY_DEVOPS_KEY=

# The key a caller sends as "Authorization: Bearer <key>". At least 32 characters, e.g.
#   openssl rand -hex 24
AUTHZEN_API_KEY=
