# The server decides with the example policy baked into the image: embedded PDP mode, no
# Policy Editor needed at runtime.
dsconfig set-policy-decision-service-prop \
    --set pdp-mode:embedded \
    --set trust-framework-version:v2 \
    --set deployment-package-source-type:static-file \
    --set "deployment-package</opt/in/authzen-example.deploymentpackage"
